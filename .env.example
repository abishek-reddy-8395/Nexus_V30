# ── Database (Railway provides these automatically if you add Postgres/Redis services) ──
DATABASE_URL=postgresql://user:pass@host:5432/nexus
REDIS_URL=redis://default:pass@host:6379

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-32-char-random-string-here
JWT_REFRESH_SECRET=another-32-char-random-string

# ── AI (PRIMARY: Gemini 2.0 Flash — fastest, cheapest, best for trading analysis) ──
GEMINI_API_KEY=your-google-ai-studio-api-key
# Optional: OpenAI fallback
# OPENAI_API_KEY=sk-...

# ── Market Data Sources ──────────────────────────────────────────────
# AI Model used: gemini-3.5-flash (default), gemini-3.1-pro-preview (enterprise), gemini-3.1-flash-lite (scanner)
# Alpha Vantage — free tier: 500 req/day (metals, forex, indices)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your-alpha-vantage-key

# Twelve Data — free tier: 800 credits/day (forex, stocks, crypto)
# Get key at: https://twelvedata.com/pricing
TWELVE_DATA_KEY=your-twelve-data-key

# ── Deployment ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Set to 'railway' to enable standalone Next.js output
DEPLOY_TARGET=railway

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://YOUR_RAILWAY_BACKEND_URL.railway.app

# ── Kafka (OPTIONAL — leave unset on Railway free tier) ─────────────
# KAFKA_ENABLED=true
# KAFKA_BROKERS=localhost:9092
