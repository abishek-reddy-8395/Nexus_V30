{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "FRONTEND_ORIGIN",
    "DATABASE_URL",
    "TIMESCALEDB_URL",
    "REDIS_URL",
    "KAFKA_BROKERS",
    "KAFKA_CLIENT_ID",
    "KAFKA_ENABLED",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "ENCRYPTION_KEY",
    "GEMINI_API_KEY",
    "OPENAI_API_KEY",
    "TWELVEDATA_API_KEY",
    "BINANCE_API_KEY",
    "BINANCE_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PRO_PRICE_ID",
    "STRIPE_ENTERPRISE_PRICE_ID",
    "AI_ENABLED",
    "DISABLE_RATE_LIMITS",
    "PRICE_CACHE_TTL",
    "CANDLE_CACHE_TTL",
    "LOG_LEVEL",
    "SENTRY_DSN",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint":      { "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "clean":     { "cache": false },
    "db:generate": { "cache": false },
    "db:migrate":  { "cache": false },
    "db:push":     { "cache": false },
    "db:seed":     { "cache": false, "dependsOn": ["db:migrate"] }
  }
}
