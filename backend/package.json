{
  "name": "@nexus-v30/backend",
  "version": "30.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/database/seed/run.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:unit": "jest --testPathPattern=\"auth|journal|engine.service|engine.determinism|replay\"",
    "test:integration": "jest --testPathPattern=\"api.integration|websocket\"",
    "test:all": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "axios": "^1.8.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "node-cache": "^5.1.2",
    "pg": "^8.11.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0",
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@nexus-v30/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.0",
    "jest": "^30.0.0",
    "ts-jest": "^30.0.0",
    "prisma": "^6.5.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.2"
  }
}
